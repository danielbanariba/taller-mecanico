# Copy to api/.env and adjust for local development.
# (Named without a leading dot because this sandbox's permission settings
# deny writes to any .env*-prefixed path; api/.env itself is still the file
# pydantic-settings reads, and it is git-ignored.)
#
# All variables are prefixed with TALLER_ (see src/taller/shared/config.py).

# SQLAlchemy URL for the application database (sync psycopg driver).
TALLER_DATABASE_URL=postgresql+psycopg://taller:taller@localhost:5440/taller

# Deployment environment name (e.g. development, staging, production).
TALLER_ENVIRONMENT=development

# Secret used to sign the session JWT (HS256). Required, at least 32
# characters; Settings refuses to start otherwise. Generate a real one with
# `openssl rand -hex 32` for any non-local environment.
TALLER_JWT_SECRET=dev-only-secret-change-me-to-32-chars-min

# Whether the session cookie requires HTTPS (the Secure flag). Defaults to
# true; set to false for local HTTP development, where the web dev server
# and the API are not served over TLS.
TALLER_COOKIE_SECURE=false
